# Local Development & Environment Configuration
# Copy this file to .env before running locally: cp .env.example .env

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Vertex AI Agent Engine Deployment Endpoint
AGENT_ENGINE_RESOURCE_NAME=projects/your-project-id/locations/us-east1/reasoningEngines/your-engine-id

# Google Cloud Storage Public Bucket
GCS_MEDIA_BUCKET=your-fitguide-media-bucket

# Google Cloud Firestore Configuration
FIRESTORE_PROJECT_ID=your-gcp-project-id

# Optional: Gemini API Key (if using AI Studio instead of Vertex AI)
# GEMINI_API_KEY=your-api-key-here

# Server Port
PORT=8080
